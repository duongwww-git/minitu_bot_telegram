BOT_TOKEN=
WEBHOOK_SECRET=
CRON_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_USER_IDS=
ALLOWED_GROUP_IDS=
ADMIN_USER_ID=
BOT_USERNAME=
GROUP_TIMEZONE=Asia/Bangkok
DIGEST_HOUR_LOCAL=6

# ---- v2: Google Gemini AI ----
# Slot A: text -> tasks (Gemini Flash). Slot B: voice -> text (Gemini Transcribe).
GEMINI_API_KEY=
AI_MODEL_TEXT=gemini-3.8-flash
AI_MODEL_TRANSCRIBE=gemini-3.5-transcribe
# USE_AI=false keeps the v1 rule-based parser as the default path.
USE_AI=false
VOICE_QUEUE_MAX=5
VOICE_DRAIN_MAX=3
VOICE_RETRY_TTL_HOURS=48
