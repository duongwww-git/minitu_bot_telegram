# ---- secrets (required, set in Vercel env vars or local .env) ----
BOT_TOKEN=
WEBHOOK_SECRET=
CRON_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- deployment identity (set in Vercel env vars) ----
ALLOWED_USER_IDS=
ALLOWED_GROUP_IDS=
ADMIN_USER_ID=
BOT_USERNAME=

# ---- optional AI key (set only if you want AI text parsing and/or voice) ----
GEMINI_API_KEY=

# ---- non-secret tunables ----
# Defaults live in the committed config.defaults.json. Only uncomment a line
# here (or add a Vercel env var) if you want to override that default.
# Precedence: env var > config.defaults.json > built-in default.
# GROUP_TIMEZONE=Asia/Bangkok
# DIGEST_HOUR_LOCAL=6
# AI_MODEL_TEXT=gemini-3.8-flash
# AI_MODEL_TRANSCRIBE=gemini-3.5-transcribe
# USE_AI=false
# VOICE_QUEUE_MAX=5
# VOICE_DRAIN_MAX=3
# VOICE_RETRY_TTL_HOURS=48
# UPCOMING_DAYS=30
